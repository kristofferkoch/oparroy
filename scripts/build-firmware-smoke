#!/bin/sh
# Smoke build: prove the freestanding flag set compiles for host, host
# LLVM bitcode (KLEE's input, DESIGN.md §8), and RV32EC (CH32V003, §5).
set -eu
. "$(dirname "$0")/freestanding-flags.sh"

src=firmware/smoke/smoke.cpp
out=build/smoke
mkdir -p "$out"

# Host object — the configuration unit tests and clang-tidy share.
clang++ $FREESTANDING_FLAGS -c "$src" -o "$out/smoke-host.o"
# LLVM bitcode for KLEE (LLVM version must match klee's — see flake.nix).
# Lifetime markers are off: klee 3.2 doesn't implement the intrinsic
# (T16c note in KANBAN.md); they carry no semantics we need in proofs.
clang++ $FREESTANDING_FLAGS -Xclang -disable-lifetime-markers \
    -emit-llvm -c "$src" -o "$out/smoke-host.bc"
# Target object — RV32EC, ilp32e ABI.
riscv64-none-elf-g++ $FREESTANDING_FLAGS -march=rv32ec -mabi=ilp32e \
    -c "$src" -o "$out/smoke-rv32ec.o"

echo "smoke build OK:"
ls -l "$out"
