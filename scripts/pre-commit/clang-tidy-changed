#!/bin/sh
# clang-tidy over the files pre-commit hands us, replaying the host
# build's compile_commands.json so the flag set is meson's single
# source (T20). Warm: about a second for a file or two.
set -u

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
builddir="$root/build/host"

if [ ! -f "$builddir/compile_commands.json" ]; then
    echo "clang-tidy-changed: setting up $builddir (one-off)" >&2
    meson setup "$builddir" --native-file "$root/meson/native/clang.ini" > /dev/null
fi

# clang-tidy is the unwrapped LLVM binary: the nix clang wrapper
# injects its resource dir and C++ headers at compile time, so neither
# lands in compile_commands.json. Append both by hand — libc++ (same
# LLVM, flake-pinned) keeps the parse reproducible instead of whatever
# GCC the host happens to have. The -std/-ffreestanding flags are also
# appended: harmless duplicates for files in the database, and they
# keep files not yet added to the meson build (no DB entry) parseable.
: "${OPARROY_LIBCXX_INCLUDE:?run inside the nix dev shell (nix develop)}"

status=0
for f do
    clang-tidy --quiet -p "$builddir" "$f" -- \
        -std=c++23 -ffreestanding -fno-exceptions -fno-rtti \
        -resource-dir "$(clang -print-resource-dir)" \
        -nostdinc++ -isystem "$OPARROY_LIBCXX_INCLUDE" || status=1
done
exit "$status"
